@scope("__SDK_CONFIG__") @val external repoName: string = "repoName"
@scope("__SDK_CONFIG__") @val external repoVersion: string = "repoVersion"
@scope("__SDK_CONFIG__") @val external repoPublicPath: string = "publicPath"
@scope("__SDK_CONFIG__") @val external backendEndPoint: string = "backendEndPoint"
@scope("__SDK_CONFIG__") @val external confirmEndPoint: string = "confirmEndPoint"
@scope("__SDK_CONFIG__") @val external sdkUrl: string = "sdkUrl"
@scope("__SDK_CONFIG__") @val external logEndpoint: string = "logEndpoint"
@scope("__SDK_CONFIG__") @val external sentryDSN: string = "sentryDSN"
@scope("__SDK_CONFIG__") @val external sentryScriptUrl: string = "sentryScriptUrl"
@scope("__SDK_CONFIG__") @val external enableLogging: bool = "enableLogging"
@scope("__SDK_CONFIG__") @val external loggingLevelStr: string = "loggingLevel"
@scope("__SDK_CONFIG__") @val external maxLogsPushedPerEventName: int = "maxLogsPushedPerEventName"
let targetOrigin: string = "*"
@scope("__SDK_CONFIG__") @val external isInteg: bool = "isIntegrationEnv"
@scope("__SDK_CONFIG__") @val external isSandbox: bool = "isSandboxEnv"
@scope("__SDK_CONFIG__") @val external isProd: bool = "isProductionEnv"
@scope("__SDK_CONFIG__") @val external isLocal: bool = "isLocal"

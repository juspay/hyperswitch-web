{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "fixtures/**/*.ts",
    "setup/**/*.ts",
    "e2e/**/*.ts",
    "reporters/**/*.ts"
  ],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}

{
  "_source": "synthetic",
  "_note": "TrustPay bank redirects (iDEAL, Blik, EPS) on the Trustpay profile. One confirm per payment_method_type. Synthetic, modelled on the SDK's clientList decoder (PaymentMethodsRecord.itemToObjMapperFromClientList) and confirm next_action handling (PaymentHelpers.res / PaymentConfirmTypes.res). confirm answers requires_customer_action + next_action.redirect_to_url; the redirect target host is the one the spec asserts (or *.hermetic.invalid where the live host is unknown) and is served a stub page. Replace with a RECORD=1 capture when sandbox credentials are available.",
  "routes": [
    {
      "name": "clientList",
      "method": "GET",
      "path": "/payments/:paymentId/client",
      "status": 200,
      "body": {
        "payment_methods_enabled": [
          {
            "payment_method": "card",
            "payment_method_type": "credit",
            "card_networks": [
              "Visa",
              "Mastercard",
              "AmericanExpress",
              "DinersClub",
              "Discover",
              "JCB",
              "UnionPay"
            ],
            "payment_experience": [],
            "customer_acceptance_support": "supported"
          },
          {
            "payment_method": "card",
            "payment_method_type": "debit",
            "card_networks": [
              "Visa",
              "Mastercard",
              "AmericanExpress",
              "DinersClub",
              "Discover",
              "JCB",
              "UnionPay"
            ],
            "payment_experience": [],
            "customer_acceptance_support": "supported"
          },
          {
            "payment_method": "bank_redirect",
            "payment_method_type": "ideal",
            "payment_experience": [],
            "customer_acceptance_support": "unsupported"
          },
          {
            "payment_method": "bank_redirect",
            "payment_method_type": "blik",
            "payment_experience": [],
            "customer_acceptance_support": "unsupported"
          },
          {
            "payment_method": "bank_redirect",
            "payment_method_type": "eps",
            "payment_experience": [],
            "customer_acceptance_support": "unsupported"
          }
        ],
        "customer_payment_methods": [],
        "intent_data": {
          "currency": "{{intent.currency}}",
          "amount": "{{intent.amount}}",
          "customer_id": "{{intent.customer_id}}",
          "email": "{{intent.email}}",
          "billing": "{{intent.billing}}",
          "shipping": "{{intent.shipping}}",
          "merchant_name": "Hermetic Test Merchant",
          "payment_type": "normal",
          "mandate_payment": null,
          "setup_future_usage": "{{intent.setup_future_usage}}",
          "is_tax_calculation_enabled": false,
          "is_guest_customer": false,
          "installment_options": null
        },
        "sdk_next_action": {
          "next_action": null,
          "should_block_confirm": false
        }
      }
    },
    {
      "name": "confirm",
      "method": "POST",
      "path": "/payments/:paymentId/confirm",
      "match": {
        "body": {
          "payment_method_type": "ideal"
        }
      },
      "status": 200,
      "intentPatch": {
        "status": "{{response.status}}"
      },
      "body": {
        "payment_id": "{{intent.payment_id}}",
        "merchant_id": "{{merchant_id}}",
        "status": "requires_customer_action",
        "amount": "{{intent.amount}}",
        "net_amount": "{{intent.amount}}",
        "amount_capturable": "{{intent.amount}}",
        "amount_received": null,
        "connector": "trustpay",
        "client_secret": "{{intent.client_secret}}",
        "created": "{{intent.created}}",
        "currency": "{{intent.currency}}",
        "customer_id": "{{intent.customer_id}}",
        "description": "{{intent.description}}",
        "capture_method": "{{intent.capture_method}}",
        "payment_method": "bank_redirect",
        "payment_method_type": "ideal",
        "payment_method_data": null,
        "payment_experience": null,
        "authentication_type": "{{intent.authentication_type}}",
        "next_action": {
          "type": "redirect_to_url",
          "redirect_to_url": "https://pay.ideal.nl/transactions/{{intent.payment_id}}"
        },
        "manual_retry_allowed": null,
        "connector_transaction_id": "hermetic_trustpay_txn",
        "error_code": null,
        "error_message": null,
        "profile_id": "{{intent.profile_id}}",
        "billing": "{{intent.billing}}",
        "shipping": "{{intent.shipping}}",
        "email": "{{intent.email}}"
      }
    },
    {
      "name": "confirm",
      "method": "POST",
      "path": "/payments/:paymentId/confirm",
      "match": {
        "body": {
          "payment_method_type": "blik"
        }
      },
      "status": 200,
      "intentPatch": {
        "status": "{{response.status}}"
      },
      "body": {
        "payment_id": "{{intent.payment_id}}",
        "merchant_id": "{{merchant_id}}",
        "status": "requires_customer_action",
        "amount": "{{intent.amount}}",
        "net_amount": "{{intent.amount}}",
        "amount_capturable": "{{intent.amount}}",
        "amount_received": null,
        "connector": "trustpay",
        "client_secret": "{{intent.client_secret}}",
        "created": "{{intent.created}}",
        "currency": "{{intent.currency}}",
        "customer_id": "{{intent.customer_id}}",
        "description": "{{intent.description}}",
        "capture_method": "{{intent.capture_method}}",
        "payment_method": "bank_redirect",
        "payment_method_type": "blik",
        "payment_method_data": null,
        "payment_experience": null,
        "authentication_type": "{{intent.authentication_type}}",
        "next_action": {
          "type": "redirect_to_url",
          "redirect_to_url": "https://e.blik.com/blik_web/index.html?transactionId={{intent.payment_id}}"
        },
        "manual_retry_allowed": null,
        "connector_transaction_id": "hermetic_trustpay_txn",
        "error_code": null,
        "error_message": null,
        "profile_id": "{{intent.profile_id}}",
        "billing": "{{intent.billing}}",
        "shipping": "{{intent.shipping}}",
        "email": "{{intent.email}}"
      }
    },
    {
      "name": "confirm",
      "method": "POST",
      "path": "/payments/:paymentId/confirm",
      "match": {
        "body": {
          "payment_method_type": "eps"
        }
      },
      "status": 200,
      "intentPatch": {
        "status": "{{response.status}}"
      },
      "body": {
        "payment_id": "{{intent.payment_id}}",
        "merchant_id": "{{merchant_id}}",
        "status": "requires_customer_action",
        "amount": "{{intent.amount}}",
        "net_amount": "{{intent.amount}}",
        "amount_capturable": "{{intent.amount}}",
        "amount_received": null,
        "connector": "trustpay",
        "client_secret": "{{intent.client_secret}}",
        "created": "{{intent.created}}",
        "currency": "{{intent.currency}}",
        "customer_id": "{{intent.customer_id}}",
        "description": "{{intent.description}}",
        "capture_method": "{{intent.capture_method}}",
        "payment_method": "bank_redirect",
        "payment_method_type": "eps",
        "payment_method_data": null,
        "payment_experience": null,
        "authentication_type": "{{intent.authentication_type}}",
        "next_action": {
          "type": "redirect_to_url",
          "redirect_to_url": "https://routing.eps.or.at/appl/epsSO/transinit/bankauswahl.htm?transactionId={{intent.payment_id}}"
        },
        "manual_retry_allowed": null,
        "connector_transaction_id": "hermetic_trustpay_txn",
        "error_code": null,
        "error_message": null,
        "profile_id": "{{intent.profile_id}}",
        "billing": "{{intent.billing}}",
        "shipping": "{{intent.shipping}}",
        "email": "{{intent.email}}"
      }
    },
    {
      "name": "redirectPage",
      "method": "GET",
      "url": "https://pay.ideal.nl/**",
      "status": 200,
      "contentType": "text/html",
      "body": "<!doctype html><html><head><title>iDEAL (hermetic stub)</title></head><body><h1>iDEAL</h1><p>Hermetic stub of the third-party redirect page. The real page is only exercised on the live tier.</p></body></html>"
    },
    {
      "name": "redirectPage",
      "method": "GET",
      "url": "https://e.blik.com/**",
      "status": 200,
      "contentType": "text/html",
      "body": "<!doctype html><html><head><title>Blik (hermetic stub)</title></head><body><h1>Blik</h1><p>Hermetic stub of the third-party redirect page. The real page is only exercised on the live tier.</p></body></html>"
    },
    {
      "name": "redirectPage",
      "method": "GET",
      "url": "https://routing.eps.or.at/**",
      "status": 200,
      "contentType": "text/html",
      "body": "<!doctype html><html><head><title>EPS (hermetic stub)</title></head><body><h1>EPS</h1><p>Hermetic stub of the third-party redirect page. The real page is only exercised on the live tier.</p></body></html>"
    }
  ]
}
